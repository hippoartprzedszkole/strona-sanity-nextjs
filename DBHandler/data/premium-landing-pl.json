                  "_type": "block",
                  "children": [
                    {
                      "_key": "35de85b9cf9d",
                      "_type": "span",
                      "marks": [],
                      "text": "Koniec jedzenia byle czego na szybko, bez dokupowania \"jednej rzeczy\" codziennie."
